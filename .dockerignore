# Build context for the image. The Dockerfile copies package manifests, the
# TypeScript source and the compiled build output only, so the rest never needs
# to travel to the daemon.
.git
.agents
.github
node_modules
build
coverage
test
analysis
docs
*.tgz
*.log
.tsbuildinfo
.env
.env.*
# The template holds no values and is not copied into the image.
!.env.example
README.md
SECURITY.md
CONTRIBUTING.md
CHANGELOG.md
AGENTS.md
