# Copy to ~/.config/polestar-mcp/.env.secrets. Never into this project tree,
# where the secret-hygiene gate treats any .env* file as a finding.
#   mkdir -p ~/.config/polestar-mcp && cp .env.example ~/.config/polestar-mcp/.env.secrets
# Real environment variables always win over that file. Every variable the
# server reads is listed here; an unrecognized POLESTAR_* name warns at startup.

# Required in live mode. Data Portal API tab -> credentials.
POLESTAR_CLIENT_ID=
POLESTAR_CLIENT_SECRET=
# Required. The Account ID shown next to the Base URL. NOT the OAuth client id:
# the gateway answers 403 AUTHZ_CLIENT_ID_MISMATCH when x-client-id carries it.
POLESTAR_ACCOUNT_ID=

# Optional: third-party credentials selecting a shared account. A value that
# does not exist is accepted and ignored by the API, and this server cannot
# verify it: polestar_status reports budget, cache, and sampling, not which
# delegated account the gateway resolved. Watch the payloads instead.
# POLESTAR_DELEGATED_ACCOUNT_ID=
# POLESTAR_DELEGATED_ACCOUNT_IDS=a@x,b@y   # accounts callers may select per call

# Where the dotenv file lives. Unset means ~/.config/polestar-mcp/.env.secrets;
# the file is never looked for inside the project tree.
# POLESTAR_ENV_FILE=/absolute/path/.env.secrets

# Optional behaviour.
# POLESTAR_BASE_URL=https://pc-api.polestar.com/eu-north-1/data-portal/m2m
# POLESTAR_M2M_TOKEN_ENDPOINT=            # overrides BASE_URL/token
# POLESTAR_TIMEOUT_MS=15000
# POLESTAR_BUDGET=10000                   # daily live-call ceiling, fails closed
# POLESTAR_BUDGET_PER_MINUTE=100           # the API also allows 100 req/min; waits it out
# POLESTAR_BUDGET_LEDGER=                  # absolute path to a JSON file, so restarts share the daily count
# POLESTAR_VEHICLE_LABELS="VIN=My Car"     # name your cars; the API returns VINs only
# POLESTAR_SAMPLE=on                       # background sampling (needs POLESTAR_HISTORY_DIR)
# POLESTAR_CACHE=off
# POLESTAR_SCOPES="pdp-telemetry/battery" # least-privilege token
# POLESTAR_REDACT_VIN=1                   # mask VINs in rendered output and in the
#                                           # structured envelope; raw:true still
#                                           # returns the payload as the API sent it
# POLESTAR_ALLOW_LOCATION=false           # never read or return position
# POLESTAR_UNITS=km                       # km | mi
# POLESTAR_LOG=debug
# POLESTAR_ENABLE_WRITES=0                # no v1 write endpoints exist; registers nothing
# POLESTAR_STRICT_ENV=1                   # make an unrecognized POLESTAR_* name fatal

# Local history store (opt-in). Enables the history tools; recording is passive
# until POLESTAR_SAMPLE starts the background sampler.
# POLESTAR_HISTORY_DIR=~/.local/share/polestar-mcp/history
# POLESTAR_HISTORY_SAMPLE_SECONDS=600      # 60 to 3600

# Offline: serve the captured dump, no credentials required.
# POLESTAR_FIXTURES_DIR=./test/fixtures/dump

# HTTP mode (loopback only unless POLESTAR_HTTP_TOKEN is set).
# POLESTAR_HTTP_PORT=0
# POLESTAR_HTTP_HOST=127.0.0.1
# POLESTAR_HTTP_TOKEN=
# POLESTAR_HTTP_ALLOWED_ORIGINS=https://app.example.com  # comma-separated browser origins;
#                                                        # unset means same-host-origin only
